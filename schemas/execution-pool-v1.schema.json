{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HomericIntelligence/Myrmidons/schemas/execution-pool-v1.schema.json",
  "title": "Myrmidons ExecutionPool v1",
  "description": "Desired capacity and execution policy. No runtime state or credentials.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "myrmidons/v1"},
    "kind": {"const": "ExecutionPool"},
    "metadata": {
      "type": "object", "required": ["name"], "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "displayName": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "required": ["host", "backend", "purpose", "workers", "conversationsPerWorker", "allocation", "overhead", "workload", "workerProfiles", "admission", "schedule"],
      "additionalProperties": false,
      "properties": {
        "host": {"$ref": "#/$defs/identifier"},
        "backend": {"enum": ["native", "container", "slurm"]},
        "purpose": {"enum": ["agents", "builds"]},
        "platform": {"enum": ["darwin/arm64", "linux/arm64", "linux/amd64"]},
        "exclusiveGroup": {
          "$ref": "#/$defs/identifier",
          "description": "A Fleet can select only one pool in each exclusive group."
        },
        "workers": {"type": "integer", "minimum": 1},
        "conversationsPerWorker": {"type": "integer", "minimum": 0},
        "allocation": {
          "type": "object", "required": ["cpus", "memoryGiB", "gpus"], "additionalProperties": false,
          "properties": {
            "cpus": {"type": "integer", "minimum": 1},
            "memoryGiB": {"type": "integer", "minimum": 1},
            "gpus": {"type": "integer", "minimum": 0}
          },
          "description": "Per-worker aggregate allocation. Shared conversations do not have separate cgroups."
        },
        "overhead": {"$ref": "#/$defs/budget"},
        "workload": {"$ref": "#/$defs/budget"},
        "workerProfiles": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["workerId", "privateHomeRef", "permissionProfileRef"], "additionalProperties": false,
            "properties": {
              "workerId": {"$ref": "#/$defs/identifier"},
              "privateHomeRef": {"$ref": "#/$defs/identifier"},
              "permissionProfileRef": {"$ref": "#/$defs/identifier"},
              "authProfileRef": {"$ref": "#/$defs/identifier"}
            }
          },
          "description": "One stable identity per worker. References resolve in trusted operator configuration outside this dataset."
        },
        "runtime": {
          "type": "object", "required": ["program", "version", "nestedAgents", "authentication"], "additionalProperties": false,
          "properties": {
            "program": {"const": "codex"},
            "version": {"const": "0.153.4"},
            "nestedAgents": {"const": false},
            "authentication": {"const": "independent-native-login"}
          }
        },
        "container": {
          "type": "object", "required": ["image"], "additionalProperties": false,
          "properties": {
            "image": {
              "type": ["string", "null"], "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
              "description": "Build-observed digest reference, or null while disabled. Tags do not qualify."
            }
          }
        },
        "slurm": {
          "type": "object", "required": ["partition", "transport"], "additionalProperties": false,
          "properties": {
            "partition": {"$ref": "#/$defs/identifier"},
            "transport": {"const": "ssh-attach"},
            "containerPlugin": {"const": "pyxis"}
          }
        },
        "admission": {
          "type": "object", "required": ["enabled"], "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}}
        },
        "schedule": {
          "type": "object", "required": ["enabled", "timezone", "weekdays", "submit", "drain", "terminate"], "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "timezone": {"type": "string", "minLength": 1},
            "weekdays": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1, "maximum": 7}
            },
            "submit": {"$ref": "#/$defs/time"},
            "drain": {"$ref": "#/$defs/time"},
            "terminate": {"$ref": "#/$defs/time"}
          },
          "description": "Local wall times in the IANA timezone; ISO weekdays use Monday=1. Agamemnon enforces the schedule."
        }
      },
      "allOf": [
        {
          "if": {"properties": {"purpose": {"const": "agents"}}},
          "then": {
            "required": ["runtime"],
            "properties": {
              "conversationsPerWorker": {"minimum": 1},
              "workerProfiles": {"items": {"required": ["authProfileRef"]}}
            }
          },
          "else": {
            "not": {"required": ["runtime"]},
            "properties": {
              "conversationsPerWorker": {"const": 0},
              "workerProfiles": {"items": {"not": {"required": ["authProfileRef"]}}}
            }
          }
        },
        {
          "if": {"properties": {"backend": {"const": "slurm"}}},
          "then": {"required": ["slurm", "container"]},
          "else": {"not": {"required": ["slurm"]}}
        },
        {
          "if": {"properties": {"backend": {"const": "container"}}},
          "then": {"required": ["container"]}
        },
        {
          "if": {"properties": {"backend": {"const": "native"}}},
          "then": {"not": {"required": ["container"]}}
        }
      ]
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "budget": {
      "type": "object", "required": ["cpus", "memoryGiB"], "additionalProperties": false,
      "properties": {
        "cpus": {"type": "integer", "minimum": 0},
        "memoryGiB": {"type": "integer", "minimum": 0}
      }
    },
    "time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
  }
}
